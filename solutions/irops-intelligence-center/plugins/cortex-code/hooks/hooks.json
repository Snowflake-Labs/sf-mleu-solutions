{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash hooks/block-prod-warehouse.sh" },
          { "type": "command", "command": "bash hooks/block-destructive-sql.sh" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash hooks/block-system-path-write.sh" }
        ]
      }
    ]
  }
}
